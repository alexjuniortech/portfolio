{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "docker:build": "docker build -t portfolio:prod .",
    "docker:run": "docker run --rm -p 4173:80 portfolio:prod",
    "deploy:s3": "npm run build && aws s3 sync dist/ s3://$S3_BUCKET --delete --acl public-read"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.9",
    "react-icons": "^5.7.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.0",
    "vite": "^8.0.0"
  }
}
